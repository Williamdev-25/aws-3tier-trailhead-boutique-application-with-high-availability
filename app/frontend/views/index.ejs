<%- include('_header') %>

<h1>Shop</h1>
<% if (products.length === 0) { %>
  <p>No products found.</p>
<% } else { %>
  <div class="product-grid">
    <% products.forEach(function(p) { %>
      <a class="product-card" href="/product/<%= p.id %>">
        <div class="product-card-body">
          <h3><%= p.name %></h3>
          <p><%= p.description %></p>
          <p class="price"><%= cents(p.priceCents) %></p>
        </div>
      </a>
    <% }); %>
  </div>
<% } %>

<%- include('_footer') %>
